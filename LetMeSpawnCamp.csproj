<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>LetMeSpawnCamp</AssemblyName>
    <Description>LetMeSpawnCamp mod for Ultimate Chicken Horse</Description>
    <Version>1.0.0</Version>
