    <Reference Include="libs\UnityEngine.dll"><Private>False</Private></Reference>
    <Reference Include="libs\UnityEngine.CoreModule.dll"><Private>False</Private></Reference>
    <Reference Include="libs\UnityEngine.UI.dll"><Private>False</Private></Reference>
    <Reference Include="libs\UnityEngine.Networking.dll"><Private>False</Private></Reference>
    <Reference Include="libs\UnityEngine.IMGUIModule.dll"><Private>False</Private></Reference>
    <Reference Include="libs\UnityEngine.TextRenderingModule.dll"><Private>False</Private></Reference>
    <Reference Include="libs\UnityEngine.InputLegacyModule.dll"><Private>False</Private></Reference>
    <Reference Include="libs\UnityEngine.ImageConversionModule.dll"><Private>False</Private></Reference>
    <Reference Include="libs\UnityEngine.AssetBundleModule.dll"><Private>False</Private></Reference>
    <Reference Include="libs\com.unity.multiplayer-hlapi.Runtime.dll"><Private>False</Private></Reference>
